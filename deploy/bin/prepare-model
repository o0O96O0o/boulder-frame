#!/usr/bin/env python3
"""Provision the manifest-pinned ONNX artifact, never an unchecked runtime model."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


def verify(path: Path, pin: dict) -> None:
    if not path.is_file() or path.stat().st_size != pin["size_bytes"]:
        raise ValueError(f"model size verification failed: {path}")
    with path.open("rb") as stream:
        digest = hashlib.file_digest(stream, "sha256").hexdigest()
    if digest != pin["sha256"]:
        raise ValueError(f"model SHA-256 verification failed: {path}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "artifact",
        nargs="?",
        type=Path,
        help="install an already exported, manifest-matching ONNX file instead of exporting",
    )
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[2]
    manifest_path = root / "worker/models/model-manifest.json"
    manifest = json.loads(manifest_path.read_text())
    artifact = manifest["artifacts"][0]
    model_dir = Path(
        os.environ.get("MODEL_DIR_HOST", str(root / "worker/models"))
    ).resolve()
    model_dir.mkdir(parents=True, exist_ok=True)
    target = model_dir / artifact["file_name"]
    if target.exists() and not target.is_file():
        raise ValueError(f"model destination is not a regular file: {target}")
    if target.is_file():
        try:
            verify(target, artifact)
        except ValueError:
            pass
        else:
            target.chmod(0o444)
            print(f"Verified model: {target}")
            print(
                f"Set MODEL_VERSION={manifest['model_version']} before starting the worker."
            )
            return

    with tempfile.TemporaryDirectory(
        prefix=".prepare-model-", dir=model_dir
    ) as directory:
        work = Path(directory)
        staged = work / artifact["file_name"]
        if args.artifact is not None:
            source = args.artifact.resolve()
            verify(source, artifact)
            shutil.copyfile(source, staged)
        else:
            if shutil.which("uv") is None:
                raise ValueError(
                    "export requires uv; alternatively pass a verified exported ONNX file"
                )
            checkpoint_pin = artifact["source_checkpoint"]
            checkpoint = work / checkpoint_pin["file_name"]
            print("Downloading the manifest-pinned source checkpoint", flush=True)
            subprocess.run(
                [
                    "curl",
                    "--fail",
                    "--location",
                    "--retry",
                    "3",
                    "--output",
                    str(checkpoint),
                    checkpoint_pin["source_url"],
                ],
                check=True,
            )
            verify(checkpoint, checkpoint_pin)
            export = artifact["export"]
            command = [
                "uv",
                "run",
                "--isolated",
                "--no-project",
                "--python",
                export["python"],
            ]
            if sys.platform.startswith("linux"):
                command.extend(
                    [
                        "--index",
                        "https://download.pytorch.org/whl/cpu",
                        "--index-strategy",
                        "unsafe-best-match",
                    ]
                )
            for package, version in export["packages"].items():
                if sys.platform.startswith("linux") and package in {
                    "torch",
                    "torchvision",
                }:
                    version += "+cpu"
                command.extend(["--with", f"{package}=={version}"])
            command.extend(
                [
                    "python",
                    str(root / "deploy/bin/export-model.py"),
                    str(manifest_path),
                    str(checkpoint),
                    str(staged),
                ]
            )
            subprocess.run(command, cwd=work, check=True)
        try:
            verify(staged, artifact)
        except ValueError as error:
            raise ValueError(
                f"{error}; export bytes can differ by platform. Install the exact approved ONNX "
                "file with `./deploy/bin/local prepare-model /path/to/yolo26n.onnx`; "
                "do not change the manifest to accept an unreviewed export"
            ) from error
        staged.chmod(0o444)
        os.replace(staged, target)
    print(f"Prepared and verified model: {target}")
    print(f"Set MODEL_VERSION={manifest['model_version']} before starting the worker.")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        print(f"prepare-model: {error}", file=sys.stderr)
        sys.exit(1)
