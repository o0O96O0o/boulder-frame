COMPOSE_PROJECT_NAME=boulder-frame

DATABASE_URL=postgres://dev:replace-with-postgres-password@postgres.example.internal:5432/bf_dev?sslmode=disable
REDIS_URL=redis://:replace-with-redis-password@redis.example.internal:6379/0

S3_ENDPOINT=https://storage.example.internal
S3_PRESIGN_ENDPOINT=https://storage.example.internal
S3_REGION=us-east-1
S3_BUCKET=replace-with-external-bucket
S3_ACCESS_KEY=replace-with-external-access-key
S3_SECRET_KEY=replace-with-external-secret-key
S3_FORCE_PATH_STYLE=true

API_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:5173
SIGNED_URL_TTL=15m
HTTP_ADDR=:8080
DEVELOPMENT_OWNER=development-owner

MODEL_VERSION=unset-until-pinned
MODEL_DIR=/models
MODEL_DIR_HOST=./worker/models
PIPELINE_VERSION=w0.2.6
DETECTION_SAMPLE_FPS=10
WORKER_ID=boulder-frame-worker-local
MAX_UPLOAD_BYTES=2147483648

# Worker-only settings (shared service/model values above apply to both services).
WORKER_SCRATCH_ROOT=/work
FFPROBE_BIN=ffprobe
FFMPEG_BIN=ffmpeg
WORKER_LEASE_SECONDS=300
WORKER_HEARTBEAT_SECONDS=30
WORKER_CONCURRENCY=1
WORKER_STREAM_NAME=boulder-frame:jobs
WORKER_STREAM_GROUP=boulder-frame:job-processors
# Unset uses WORKER_ID.
# WORKER_STREAM_CONSUMER=boulder-frame-worker-local
WORKER_STREAM_BLOCK_MS=1000
# Unset uses WORKER_LEASE_SECONDS * 1000.
# WORKER_STREAM_RECLAIM_IDLE_MS=300000
WORKER_RETAIN_DEBUG_ARTIFACTS=true
WORKER_DEBUG_CAPTURE=true
WORKER_DEBUG_VISUAL_CAPTURE=true
WORKER_DEBUG_REQUIRE_PRIVATE_STORAGE=false
WORKER_DEBUG_MAX_FRAMES=10000
WORKER_DEBUG_MAX_BYTES=52428800
WORKER_REVIEW_MAX_DURATION_MS=300000
WORKER_REVIEW_WIDTH=960
WORKER_REVIEW_HEIGHT=540
WORKER_REVIEW_MAX_BYTES=262144000
WORKER_REVIEW_TIMEOUT_SECONDS=600
WORKER_NORMALIZATION_MAX_SOURCE_BYTES=1073741824
WORKER_NORMALIZATION_TIMEOUT_SECONDS=1800
