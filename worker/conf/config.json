{
  "pipeline_version": "${PIPELINE_VERSION}",
  "model_version": "${MODEL_VERSION}",
  "model_dir": "${MODEL_DIR}",
  "database_url": "${DATABASE_URL}",
  "redis_url": "${REDIS_URL}",
  "s3_endpoint": "${S3_ENDPOINT}",
  "s3_presign_endpoint": "${S3_PRESIGN_ENDPOINT}",
  "s3_region": "${S3_REGION}",
  "s3_bucket": "${S3_BUCKET}",
  "s3_access_key": "${S3_ACCESS_KEY}",
  "s3_secret_key": "${S3_SECRET_KEY}",
  "s3_use_path_style": true,
  "scratch_root": "/work",
  "ffprobe_bin": "ffprobe",
  "ffmpeg_bin": "ffmpeg",
  "lease_seconds": 300,
  "heartbeat_seconds": 30,
  "concurrency": 1,
  "worker_id": "${WORKER_ID}",
  "retain_debug_artifacts": false,
  "debug_capture": false,
  "debug_visual_capture": false,
  "debug_require_private_storage": false,
  "debug_max_frames": 10000,
  "debug_max_bytes": 52428800,
  "review_max_duration_ms": 300000,
  "review_width": 960,
  "review_height": 540,
  "review_max_bytes": 262144000,
  "review_timeout_seconds": 600,
  "normalization_max_source_bytes": 1073741824,
  "normalization_timeout_seconds": 1800
}
