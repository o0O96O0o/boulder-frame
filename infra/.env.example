COMPOSE_PROJECT_NAME=boulder-frame
APP_ENV=local

DATABASE_URL=postgres://dev:replace-with-postgres-password@76.13.185.64:5432/bf_dev?sslmode=disable

REDIS_URL=redis://:replace-with-redis-password@76.13.185.64:6379/0

S3_ENDPOINT=http://srv1883301.hstgr.cloud:9000
S3_PRESIGN_ENDPOINT=http://srv1883301.hstgr.cloud:9000
S3_REGION=us-east-1
S3_BUCKET=replace-with-external-bucket
S3_ACCESS_KEY=replace-with-external-access-key
S3_SECRET_KEY=replace-with-external-secret-key
S3_FORCE_PATH_STYLE=true

API_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:5173
SIGNED_URL_TTL=15m

MODEL_VERSION=unset-until-pinned
PIPELINE_VERSION=dev
MAX_UPLOAD_BYTES=2147483648

# Replace these with immutable registry tags or Git-revision tags for online use.
FRONTEND_IMAGE=boulder-frame-frontend:0.0.0-dev
BACKEND_IMAGE=boulder-frame-backend:0.0.0-dev
WORKER_IMAGE=boulder-frame-worker:0.0.0-dev
CADDY_DOMAIN=dev.example.com
