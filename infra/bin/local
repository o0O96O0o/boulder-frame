#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$root"

compose() {
  docker compose --env-file infra/.env -f infra/compose.yaml "$@"
}

case "${1:-}" in
  start) compose up --build ;;
  start-detached) compose up --build -d ;;
  migrate) compose run --rm backend migrate up ;;
  status) compose ps ;;
  logs) shift; compose logs -f "$@" ;;
  stop) exec compose down ;;
  reset) exec compose down -v ;;
  *)
    echo "usage: $0 {start|start-detached|migrate|status|logs|stop|reset}" >&2
    exit 64
    ;;
esac
