#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$root"

compose() {
  docker compose --env-file infra/.env -f infra/compose.yaml -f infra/compose.online.yaml --profile online "$@"
}

case "${1:-}" in
  pull) compose pull ;;
  start) compose up -d ;;
  update)
    compose pull
    compose up -d
    ;;
  migrate) compose run --rm backend migrate up ;;
  status) compose ps ;;
  logs) shift; compose logs --since=10m "$@" ;;
  *)
    echo "usage: $0 {pull|start|update|migrate|status|logs}" >&2
    echo "online environments intentionally do not provide a destructive reset command" >&2
    exit 64
    ;;
esac
